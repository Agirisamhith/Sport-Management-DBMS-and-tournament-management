# Copy this file to .env and fill in your values.
# All variables can also be set as OS environment variables (which take precedence).

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_club_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Connection Pool ───────────────────────────────────────────────────────────
# DB_POOL_MIN=2          # Minimum idle connections (default: 2)
# DB_POOL_MAX=10         # Maximum connections (default: 10)
# DB_POOL_TIMEOUT=30.0   # Seconds to wait for a connection (default: 30)
# DB_CONNECT_TIMEOUT=10.0  # Seconds allowed for initial DB connect (default: 10)

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# Set DEBUG=False in production: hides /docs, suppresses stack traces in logs
DEBUG=True
